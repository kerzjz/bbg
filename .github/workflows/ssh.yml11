name: Auto SSH 24h
on:
  schedule:
    - cron: "0 */6 * * *"
  workflow_dispatch:

jobs:
  tmate:
    runs-on: ubuntu-latest
    timeout-minutes: 350
    steps:
      - name: 禁区时间判断
        run: |
          set -e
          # 北京时间 小时、星期 1=周一 7=周日
          BJ_H=$(date -d '+8 hour' +%H)
          WK=$(date -d '+8 hour' +%u)

          # 每日禁区 02:00–06:00
          if [ $BJ_H -ge 2 ] && [ $BJ_H -lt 6 ]; then
            echo "当前在每日禁区，不启动SSH"
            exit 0
          fi

          # 周一~周五 08:00–12:00 14:00–18:00
          if [ $WK -ge 1 ] && [ $WK -le 5 ]; then
            if ([ $BJ_H -ge 8 ] && [ $BJ_H -lt 12 ]) || ([ $BJ_H -ge 14 ] && [ $BJ_H -lt 18 ]); then
              echo "当前在工作日禁区，不启动SSH"
              exit 0
            fi
          fi

          echo "非禁区，正常启动SSH常驻"

      - uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: 安装依赖
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: 安装 tmate
        run: sudo apt install tmate -y

      - name: 启动 tmate
        run: |
          tmate -S /tmp/tmate.sock new-session -d
          tmate -S /tmp/tmate.sock wait tmate-ready
          SSH=$(tmate -S /tmp/tmate.sock display -p '#{tmate_ssh}' | sed 's/^ssh //')
          echo "SSH_CMD=$SSH" >> $GITHUB_ENV

      - name: 生成纯文本首页
        run: |
          mkdir -p public
          echo "${{ env.SSH_CMD }}" > public/index.html

      - name: 部署到 Pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          personal_token: ${{ secrets.PAT }}
          external_repository: kerzjz/bbgp
          publish_dir: ./public
          publish_branch: gh-pages
          allow_empty_commit: true

      - name: 保持连接（断开自动结束Job）
        run: |
          while tmate -S /tmp/tmate.sock has-session; do
            sleep 1
          done
